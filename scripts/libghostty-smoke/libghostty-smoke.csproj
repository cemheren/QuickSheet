<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loads a libghostty-vt build through QuickSheet's real binding code (Terminal/*.cs).
       Run by CI before a build is published. Not part of the app or the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>LibGhosttySmoke</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);PLATFORM_LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Terminal/*.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
