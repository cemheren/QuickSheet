<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Build only the appropriate TFM for the current OS -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);PLATFORM_WINDOWS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <TargetFramework>net9.0</TargetFramework>
    <DefineConstants>$(DefineConstants);PLATFORM_LINUX</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows')) AND !$([MSBuild]::IsOSPlatform('Linux'))">
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <!-- Only compile the platform code for the current OS -->
  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <Compile Remove="Platform/Windows/**" />
    <EmbeddedResource Remove="Platform/Windows/**" />
    <None Remove="Platform/Windows/**" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Linux'))">
    <Compile Remove="Platform/Linux/**" />
    <EmbeddedResource Remove="Platform/Linux/**" />
    <None Remove="Platform/Linux/**" />
  </ItemGroup>

  <!-- Build helper trees are never compiled or shipped as content. -->
  <ItemGroup>
    <Compile Remove="native/**;scripts/**" />
    <None Remove="native/**;scripts/**" />
  </ItemGroup>

  <!-- libghostty-vt native library (optional; built by scripts/build-libghostty.*). Not a NuGet package.
       Only the folder matching this OS and architecture is copied, flattened into the output root. -->
  <PropertyGroup>
    <QsNativeArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</QsNativeArch>
    <QsNativeArch Condition="'$(QsNativeArch)' == 'X64'">x64</QsNativeArch>
    <QsNativeArch Condition="'$(QsNativeArch)' == 'Arm64'">arm64</QsNativeArch>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <None Include="native/win-$(QsNativeArch)/ghostty-vt.dll"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <None Include="native/linux-$(QsNativeArch)/libghostty-vt.so*"
          CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

</Project>
